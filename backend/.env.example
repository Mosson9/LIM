# LIM backend configuration — copy to .env and adjust. All values are optional;
# defaults make the server run with zero configuration.

# HTTP listen address.
LIM_ADDR=:8080

# Path to the JSON snapshot store (the whole DB lives in this file).
LIM_DATA_FILE=lim-data.json

# Secret used to sign JWT access tokens. MUST be changed for production.
LIM_JWT_SECRET=dev-secret-change-me

# Access-token lifetime, in hours (default 720h = 30 days).
LIM_TOKEN_TTL_HOURS=720

# CORS origin allowed for the admin web app ("*" = any).
LIM_CORS_ORIGIN=*

# Seed demo users/decisions/transactions on first boot.
LIM_SEED_DEMO=true

# Bootstrap admin account (created on first boot if absent).
LIM_ADMIN_EMAIL=admin@lim.app
LIM_ADMIN_PASSWORD=admin123

# --- Optional: Claude-backed analysis engine ---
# When ANTHROPIC_API_KEY is set, /analyze asks Claude for the six-dimension
# scoring and gracefully falls back to the built-in heuristic on any error.
# ANTHROPIC_API_KEY=sk-ant-...
# LIM_ANTHROPIC_MODEL=claude-sonnet-4-6

# LIM backend configuration — copy to .env and adjust. All values are optional;
# defaults make the server run with zero configuration.

# HTTP listen address.
LIM_ADDR=:8080

# Path to the JSON snapshot store (the whole DB lives in this file).
# Ignored when LIM_DATABASE_URL is set.
LIM_DATA_FILE=lim-data.json

# Use Postgres instead of the file store. When set, the server creates its schema
# on boot and seeds catalogue/admin/demo data on first run, just like the file
# store. Example:
# LIM_DATABASE_URL=postgres://lim:lim@localhost:5432/lim?sslmode=disable

# Secret used to sign JWT access tokens. MUST be changed for production.
LIM_JWT_SECRET=dev-secret-change-me

# Access-token lifetime, in hours (default 720h = 30 days).
LIM_TOKEN_TTL_HOURS=720

# CORS origin allowed for the admin web app ("*" = any).
LIM_CORS_ORIGIN=*

# Security: per-IP rate limits (requests/minute) and max request body size.
LIM_RATE_RPM=240
LIM_AUTH_RATE_RPM=20
LIM_MAX_BODY_BYTES=1048576

# Seed demo users/decisions/transactions on first boot.
LIM_SEED_DEMO=true

# Bootstrap admin account (created on first boot if absent).
LIM_ADMIN_EMAIL=admin@lim.app
LIM_ADMIN_PASSWORD=admin123

# --- Optional: Claude-backed analysis engine ---
# When ANTHROPIC_API_KEY is set, /analyze asks Claude for the six-dimension
# scoring and gracefully falls back to the built-in heuristic on any error.
# ANTHROPIC_API_KEY=sk-ant-...
# LIM_ANTHROPIC_MODEL=claude-sonnet-4-6

# --- Apple StoreKit 2 receipt verification (production purchases) ---
# POST /api/v1/subscription/verify validates Apple-signed transactions. Supply
# Apple's root ("Apple Root CA - G3" from apple.com/certificateauthority) to
# verify real receipts; product ids must match the App Store Connect config.
LIM_APPLE_BUNDLE_ID=app.lim.ios
LIM_APPLE_ENV=Production
# LIM_APPLE_ROOT_CERT=/etc/lim/AppleRootCA-G3.pem
LIM_APPLE_PRODUCT_MONTHLY=app.lim.ios.plus.monthly
LIM_APPLE_PRODUCT_YEARLY=app.lim.ios.plus.yearly
# Keep the dev-only mock /subscribe endpoint. Set to false in production.
LIM_ALLOW_MOCK_SUBSCRIBE=true
